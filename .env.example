# ── Сервер ──
PORT=3000
# Регион для iTunes и чартов (ru, us, de ...)
REGION=ru
# За nginx/Cloudflare: учитывать X-Forwarded-For для лимита запросов
# TRUST_PROXY=1
# Запросов в минуту с одного IP на /api (по умолчанию 150)
# RATE_LIMIT=150

# ── Telegram ──
# Токен от @BotFather. Нужен и для бота, и для безопасной синхронизации в Mini App.
BOT_TOKEN=
# Username бота без @ (если пусто — берётся из getMe)
BOT_USERNAME=
# Короткое имя Mini App из BotFather (/newapp) — включает ссылки t.me/бот/приложение?startapp=… (работают и в группах)
BOT_APP_SHORTNAME=
# Публичный HTTPS-адрес сайта (Mini App открывается по нему)
WEBAPP_URL=
# Бот-загрузчик (без @)
LOADER_BOT=loaditbot

# ── Источники без ключей работают сразу: Deezer, iTunes, Audius ──

# ── Spotify (необязательно): developer.spotify.com → Create app ──
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── SoundCloud (необязательно): нужна заявка на доступ к API ──
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# ── Яндекс Музыка (необязательно, неофициальный API): OAuth-токен аккаунта ──
YANDEX_TOKEN=

# ── Загрузки сообщества (необязательно, только чтение): адрес PocketBase ──
PB_URL=
