# === Telegram Bot (Cloudflare Worker / Node) ===
BOT_TOKEN=
WEBAPP_URL=https://your-app.netlify.app

# === Optional: Supabase (profiles, favorites) ===
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# === Official Spotify Web API (search + 30s previews ONLY) ===
# https://developer.spotify.com/dashboard → Create app → copy Client ID & Secret
# Full commercial track streaming is NOT supported (copyright + Spotify Terms).
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_CLIENT_SECRET=

# === Optional: remote tracks JSON (array of {id,title,artist,url,cover,category}) ===
# VITE_TRACKS_API=https://your-cdn.example.com/tracks.json
