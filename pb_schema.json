[
 {
  "name": "favorites",
  "type": "base",
  "fields": [
   {
    "name": "device",
    "type": "text",
    "required": true
   },
   {
    "name": "key",
    "type": "text",
    "required": true
   },
   {
    "name": "track",
    "type": "json"
   }
  ],
  "listRule": "",
  "viewRule": "",
  "createRule": "",
  "deleteRule": ""
 },
 {
  "name": "tracks",
  "type": "base",
  "fields": [
   {
    "name": "title",
    "type": "text",
    "required": true,
    "max": 120
   },
   {
    "name": "artist",
    "type": "text",
    "required": true,
    "max": 120
   },
   {
    "name": "lyrics",
    "type": "text",
    "max": 20000
   },
   {
    "name": "audio",
    "type": "file",
    "required": true,
    "maxSelect": 1,
    "maxSize": 31457280,
    "mimeTypes": [
     "audio/mpeg",
     "audio/mp4",
     "audio/x-m4a",
     "audio/ogg",
     "audio/wav",
     "audio/x-wav",
     "audio/flac"
    ]
   },
   {
    "name": "cover",
    "type": "file",
    "maxSelect": 1,
    "maxSize": 5242880,
    "mimeTypes": [
     "image/jpeg",
     "image/png",
     "image/webp"
    ],
    "thumbs": [
     "300x300"
    ]
   },
   {
    "name": "owner",
    "type": "relation",
    "collectionId": "_pb_users_auth_",
    "maxSelect": 1,
    "required": true,
    "cascadeDelete": true
   },
   {
    "name": "ownerName",
    "type": "text",
    "max": 60
   },
   {
    "name": "status",
    "type": "select",
    "required": true,
    "maxSelect": 1,
    "values": [
     "pending",
     "approved",
     "rejected"
    ]
   },
   {
    "name": "rights",
    "type": "bool"
   }
  ],
  "listRule": "status = \"approved\" || owner = @request.auth.id",
  "viewRule": "status = \"approved\" || owner = @request.auth.id",
  "createRule": "@request.auth.id != \"\" && @request.body.owner = @request.auth.id && @request.body.status = \"pending\" && @request.body.rights = true",
  "updateRule": "owner = @request.auth.id && @request.body.status:isset = false",
  "deleteRule": "owner = @request.auth.id"
 },
 {
  "name": "playlists",
  "type": "base",
  "fields": [
   {
    "name": "name",
    "type": "text",
    "required": true,
    "max": 80
   },
   {
    "name": "owner",
    "type": "relation",
    "collectionId": "_pb_users_auth_",
    "maxSelect": 1,
    "required": true,
    "cascadeDelete": true
   },
   {
    "name": "tracks",
    "type": "json",
    "maxSize": 2000000
   }
  ],
  "listRule": "owner = @request.auth.id",
  "viewRule": "owner = @request.auth.id",
  "createRule": "@request.auth.id != \"\" && @request.body.owner = @request.auth.id",
  "updateRule": "owner = @request.auth.id",
  "deleteRule": "owner = @request.auth.id"
 },
 {
  "name": "reports",
  "type": "base",
  "fields": [
   {
    "name": "trackId",
    "type": "text",
    "required": true
   },
   {
    "name": "reason",
    "type": "text",
    "max": 500
   },
   {
    "name": "reporter",
    "type": "text"
   }
  ],
  "createRule": "@request.auth.id != \"\""
 }
]